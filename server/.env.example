# PostgreSQL connection string (например, Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Длинная случайная строка: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
PORT=3002
# Адрес фронтенда для CORS (через запятую, если несколько). Пусто = разрешить всем.
CLIENT_URL=http://localhost:5173
# Сколько неудачных попыток входа/регистрации разрешено с одного IP за 15 минут
AUTH_RATE_LIMIT=10
# Только для тестов: отдельная база, которую тесты очищают
TEST_DATABASE_URL=postgresql://user:password@localhost/vagabond_test
# Пуш-уведомления о новых сериях. Ключи: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Необязательно: если задан, рассылку (/internal/notify-airing) можно запустить только с этим ключом
CRON_SECRET=
