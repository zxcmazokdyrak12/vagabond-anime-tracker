# PostgreSQL connection string (например, Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Длинная случайная строка: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
PORT=3002
# Адрес фронтенда для CORS (через запятую, если несколько). Пусто = разрешить всем.
CLIENT_URL=http://localhost:5173
