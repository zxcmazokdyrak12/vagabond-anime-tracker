{
  "name": "Vagabond Tracker",
  "short_name": "Vagabond",
  "description": "Anime tracker drawn in sumi ink, after Takehiko Inoue's Vagabond.",
  "lang": "en",
  "start_url": "/?tab=scrolls",
  "scope": "/",
  "display": "standalone",
  "background_color": "#e2ded4",
  "theme_color": "#1b1a17",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "This week", "url": "/?tab=calendar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My scrolls", "url": "/?tab=scrolls", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
